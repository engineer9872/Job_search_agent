# Database URL
DATABASE_URL=your_database_url_here

# Adzuna API Credentials
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

RAPIDAPI_KEY=your_rapidapi_key_here
SERPAPI_API_KEY=your_serpapi_key_here

# Apify SDK API Token
APIFY_API_TOKEN=your_apify_api_token_here

# Alert Webhook Settings (Slack / Email / Custom Webhook)
ALERT_WEBHOOK_URL=your_webhook_url_here

# Pipeline Settings
DEDUP_SIMILARITY_THRESHOLD=88.0
LOG_LEVEL=INFO

# -----------------------------------------------------------------------
# 10-Portal Config — Credentials for new platform connectors
# -----------------------------------------------------------------------

# USAJOBS Official Search API (register free at https://developer.usajobs.gov)
# Required for USAJOBS T1 connector — without these, T5 cache fallback is used
USAJOBS_API_KEY=your_usajobs_authorization_key_here
USAJOBS_EMAIL=your_contact_email_here

# CareerBuilder Developer API (check https://developer.careerbuilder.com for current availability)
CAREERBUILDER_API_KEY=your_careerbuilder_dev_api_key_here

# ZipRecruiter Partner/Publisher API (requires manual application at https://www.ziprecruiter.com/partner)
ZIPRECRUITER_PARTNER_API_KEY=your_ziprecruiter_partner_key_here

# -----------------------------------------------------------------------
# Firecrawl (https://www.firecrawl.dev) — Tier 3/fallback scraping layer.
# Firecrawl uses a SINGLE key by design (see config/settings.py).
# -----------------------------------------------------------------------
FIRECRAWL_API_KEY=your_firecrawl_key_here

# -----------------------------------------------------------------------
# Bright Data (https://brightdata.com) — Tier 3/fallback scraping layer.
# Same multi-key rotation pattern as Firecrawl above.
# BRIGHTDATA_ZONE is the Web Unlocker/Scraper zone name from your dashboard.
# -----------------------------------------------------------------------
BRIGHTDATA_API_KEY=your_brightdata_key_here
BRIGHTDATA_API_KEY_1=
BRIGHTDATA_API_KEY_2=
BRIGHTDATA_ZONE=your_brightdata_zone_here
